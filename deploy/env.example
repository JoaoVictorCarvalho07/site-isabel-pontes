# Ambiente de PRODUCAO. Copie para /opt/site/.env na VM e preencha.
# NAO versione o .env real.

# --- runtime do servidor Go ---
# 127.0.0.1: so o Caddy (na mesma maquina) alcanca; a internet passa pelo Caddy.
ADDR=127.0.0.1:8080
DB_PATH=/opt/site/data/site.db
MANIFEST_PATH=/opt/site/data/manifest.json
# URL canonica: entra no og:url, canonical e sitemap. SEM barra no fim.
BASE_URL=https://isabelpontes.com.br

# --- R2 para o Litestream (backup do banco) ---
# Bucket PRIVADO, separado do bucket de midia. Ver deploy/litestream.yml.
# A chave precisa de escrita nesse bucket de backup.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=isabel-litestream
