# binário compilado
/site
/site.exe*

# banco: gerado por `site sync`, nunca versionado.
# Em prod vive num volume; o backup é o Litestream replicando para o R2.
/data/

# credenciais. O .env do projeto React ja vazou uma vez para o historico
# (chaves R2 recuperaveis ate hoje) -- nao repetir aqui.
.env
*.env
!.env.example

# dart-sass standalone. E ferramenta de build local, baixada pelo `make tools`,
# nao codigo do projeto -- ~5 MB de binario nao entram no repo.
/tools/

# saida da migracao de midia (manifest gerado + amostras de validacao).
# O manifest final vai para onde o site le, num passo separado -- nao daqui.
/scripts/out/
/out/

# script de migracao de midia: fica LOCAL. Contem credencial R2 em texto puro no
# working tree; nunca deve ser versionado (foi o que vazou a chave antiga).
# A logica nao se perde: existe na historia no commit dd2bfdf (versao os.getenv,
# sem segredo) e sera reimplementada no `site sync` do Go.
/scripts/migrate_media.py

# NAO ignorar /static/: o CSS compilado E versionado de proposito.
# E isso que mantem o runtime 100% Go -- deploy nunca precisa do sass.

# bytecode Python do script de migracao
__pycache__/
*.pyc
