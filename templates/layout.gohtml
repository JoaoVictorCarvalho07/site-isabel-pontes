{{- /*
  Layout base. Tudo que a SPA nao conseguia entregar mora aqui.

  O ponto do projeto: WhatsApp e Instagram geram o card de preview com um bot
  que NAO executa JavaScript. Na SPA ele recebia <div id="root"></div> e o
  titulo "siteisabelpontes", e o preview saia vazio. Aqui o HTML ja chega
  pronto, com title/description/og por rota.
*/ -}}
<!doctype html>
<html lang="{{ if eq .Lang "en" }}en{{ else }}pt-br{{ end }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {{- /* Tema claro/escuro: define data-theme ANTES de pintar, senao a pagina
           pisca no tema errado ao carregar. Le a escolha salva; sem escolha, segue
           o sistema. O toggle em app.js so alterna depois. Inline de proposito --
           qualquer script externo chegaria tarde demais e o flash aconteceria. */}}
    <script>
      (function () {
        try {
          var t = localStorage.getItem("tema");
          if (t !== "dark" && t !== "light") {
            t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <title>{{ .Titulo }}</title>
    {{- with .Descricao }}
    <meta name="description" content="{{ . }}" />
    {{- end }}
    {{- with .Canonical }}
    <link rel="canonical" href="{{ . }}" />
    {{- end }}
    {{- /* hreflang: as duas versoes + x-default (PT). O Google usa isto para
           servir o idioma certo e nao tratar PT/EN como conteudo duplicado. */}}
    {{- with .HrefPT }}
    <link rel="alternate" hreflang="pt-BR" href="{{ . }}" />
    <link rel="alternate" hreflang="x-default" href="{{ . }}" />
    {{- end }}
    {{- with .HrefEN }}
    <link rel="alternate" hreflang="en" href="{{ . }}" />
    {{- end }}
    <meta name="theme-color" content="#3a2a22" />

    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset "/static/img/favicon-32.png" }}" />
    <link rel="apple-touch-icon" href="{{ asset "/static/img/apple-touch-icon.png" }}" />

    {{- /* Open Graph: e o que gera o card de preview no WhatsApp e no Instagram.
           URLs absolutas -- scrapers nao resolvem relativo. */}}
    <meta property="og:type" content="{{ .OGType }}" />
    <meta property="og:site_name" content="Isabel Pontes Fotoarte" />
    <meta property="og:locale" content="{{ if eq .Lang "en" }}en_US{{ else }}pt_BR{{ end }}" />
    <meta property="og:url" content="{{ .Canonical }}" />
    <meta property="og:title" content="{{ .Titulo }}" />
    {{- with .Descricao }}
    <meta property="og:description" content="{{ . }}" />
    {{- end }}
    <meta property="og:image" content="{{ .OGImage }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Retrato artístico com coroa dourada, ao lado de um busto clássico" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ .Titulo }}" />
    {{- with .Descricao }}
    <meta name="twitter:description" content="{{ . }}" />
    {{- end }}
    <meta name="twitter:image" content="{{ .OGImage }}" />

    {{ template "jsonld" . }}

    {{- /* Sem preload de fonte de proposito: nada acima da dobra usa Cormorant
           ou Jost, entao preload aqui so competiria com o hero pelo bandwidth. */}}
    <link rel="stylesheet" href="{{ asset "/static/css/app.css" }}" />
  </head>

  <body{{ with .BodyClass }} class="{{ . }}"{{ end }}>
    <a class="skip-link" href="#conteudo">{{ t .Lang "a11y.pular" }}</a>

    {{ template "navbar" . }}

    <main id="conteudo">{{ template "conteudo" . }}</main>

    {{- /* O midia kit tem rodape proprio (contato + redes); as demais paginas
           usam o rodape padrao. */}}
    {{- if not .OcultarRodape }}
    {{ template "footer" . }}
    {{- end }}

    {{- /* htmx self-hospedado (sem CDN), defer preserva a ordem. app.js le
           htmx:afterSwap, entao o htmx carrega antes. app.js e inofensivo fora
           da galeria (guarda em #lightbox). */}}
    <script src="{{ asset "/static/js/htmx.min.js" }}" defer></script>
    <script src="{{ asset "/static/js/app.js" }}" defer></script>
  </body>
</html>
