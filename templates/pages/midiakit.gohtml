{{- /*
  Mídia kit — one-page de pitch (docs §4b). Bilíngue (Fase 10): conteúdo
  estruturado resolve por {{ .Campo.T $.Lang }}; chrome por {{ t $.Lang "..." }};
  prosa (bio, definições) por {{ if eq $.Lang "en" }}. Dados: midiakit_content.go.
*/ -}}
{{ define "conteudo" }}
{{- $en := eq .Lang "en" }}
<div class="midiakit">

  {{- /* Hero com vídeo de fundo. Mudo + loop (autoplay só é permitido mudo) e
         playsinline pra não abrir em tela cheia no iOS. O poster aparece antes de
         o vídeo carregar; quem prefere menos animação vê só ele (CSS). É
         decoração: aria-hidden + tabindex=-1 pra sair do fluxo de leitura/foco. */}}
  <section class="mk-hero">
    <video class="mk-hero__video" autoplay muted loop playsinline preload="metadata"
           poster="{{ asset "/static/img/midiakit/hero-poster.webp" }}"
           aria-hidden="true" tabindex="-1">
      <source src="{{ asset "/static/video/midiakit-hero.webm" }}" type="video/webm" />
      <source src="{{ asset "/static/video/midiakit-hero.mp4" }}" type="video/mp4" />
    </video>
    <div class="mk-hero__overlay"></div>
    <div class="mk-hero__texto">
      <h1>Isa Pontes</h1>
      <p class="mk-hero__sub">UGC Creator &amp; Diretora Criativa</p>
      <p class="mk-hero__tag">
        {{- if $en }}Organic advertising with elevated aesthetics — storytelling that connects brand and audience.
        {{- else }}Publicidade orgânica com estética elevada — storytelling que conecta marca e audiência.{{ end }}
      </p>
      <div class="mk-hero__ctas">
        <a href="#portfolio" class="mk-btn mk-btn--claro">{{ t .Lang "mk.verTrabalhos" }}</a>
        <a href="#investimento" class="mk-btn ">{{ t .Lang "mk.investimento" }}</a>
      </div>
    </div>
  </section>

  {{- /* Bio */}}
  <section id="bio" class="mk-secao mk-bio">
    {{- if $en }}
    <h2>Hi! I'm Isa <span aria-hidden="true">✨</span></h2>
    <p>
      I'm a Creative Director, Fine Art Photographer and Creator. I work as an
      Influencer and also create content for brands.
    </p>
    <p>
      My strength is <strong>authenticity and creativity</strong>. I bring my
      background in cinema, art direction and visual arts to turn products into
      stories with aesthetics and intention. You take one look and see there's
      storytelling — it's not just showing the product, it's building a narrative
      that connects.
    </p>
    {{- else }}
    <h2>Oi! Eu sou a Isa <span aria-hidden="true">✨</span></h2>
    <p>
      Sou Diretora Criativa, Fotógrafa Artística e Creator. Atuo como Influencer
      e também crio conteúdo para marcas.
    </p>
    <p>
      Meu ponto forte é <strong>autenticidade e criatividade</strong>. Trago meu
      repertório de cinema, direção de arte e artes visuais para transformar
      produtos em histórias com estética e intenção. Você bate o olho e percebe
      que tem storytelling — não é só mostrar o produto, é construir uma narrativa
      que conecta.
    </p>
    {{- end }}
    <ul class="mk-tags">
      {{- range .Tags }}
      <li>{{ .T $.Lang }}</li>
      {{- end }}
    </ul>
  </section>

  {{- /* Dicionário UGC / IGC */}}
  <section id="ugc" class="mk-secao mk-dic">
    <article class="mk-verbete">
      <h3>UGC</h3>
      <span class="mk-verbete__fon">/juː dʒiː siː/ • {{ if $en }}noun{{ else }}substantivo{{ end }}</span>
      {{- if $en }}
      <p>
        <em>User Generated Content</em>. Authentic material created to spark
        immediate identification. In my method, UGC stops being a homemade clip
        and becomes a piece of <strong>organic advertising with elevated
        aesthetics</strong>.
      </p>
      <p class="mk-verbete__por"><strong>Why hire it?</strong> Humanization, objection-breaking and conversion.</p>
      {{- else }}
      <p>
        <em>User Generated Content</em> (Conteúdo Gerado pelo Usuário). Material
        autêntico criado para gerar identificação imediata. No meu método, o UGC
        deixa de ser um vídeo caseiro e vira uma peça de
        <strong>publicidade orgânica com estética elevada</strong>.
      </p>
      <p class="mk-verbete__por"><strong>Por que contratar?</strong> Humanização, quebra de objeção e conversão.</p>
      {{- end }}
    </article>

    <article class="mk-verbete">
      <h3>IGC</h3>
      <span class="mk-verbete__fon">/aɪ dʒiː siː/ • {{ if $en }}noun{{ else }}substantivo{{ end }}</span>
      {{- if $en }}
      <p>
        <em>Influencer Generated Content</em>. Content by someone who already has
        presence and connection with an audience. In my method, IGC combines
        <strong>authority, narrative and elevated aesthetics</strong> — designed
        to build desire and trust, without feeling like an ad.
      </p>
      <p class="mk-verbete__por"><strong>Why hire it?</strong> Reach, credibility and conversion.</p>
      {{- else }}
      <p>
        <em>Influencer Generated Content</em> (Conteúdo Gerado por Influenciadora).
        Conteúdo de quem já tem presença e conexão com uma audiência. No meu
        método, o IGC une <strong>autoridade, narrativa e estética elevada</strong>
        — pensado para gerar desejo e confiança, sem cara de anúncio.
      </p>
      <p class="mk-verbete__por"><strong>Por que contratar?</strong> Alcance, credibilidade e conversão.</p>
      {{- end }}
    </article>
  </section>

  {{- /* Portfólio de vídeos */}}
  <section id="portfolio" class="mk-secao mk-portfolio">
    <h2>{{ t .Lang "mk.trabalhos" }}</h2>
    <p>{{ t .Lang "mk.curadoria" }}</p>
    {{ template "mk_portfolio" .Portfolio }}
    <a href="https://www.instagram.com/isabelpontesfotografia/" class="mk-btn"
       target="_blank" rel="noopener">{{ t .Lang "mk.verInstagram" }}</a>
  </section>

  {{- /* Métricas */}}
  <section id="metricas" class="mk-secao mk-metricas">
    <h2>{{ t .Lang "mk.metricas" }}</h2>
    <div class="mk-metricas__grid">
      {{- range .Metricas }}
      <article class="mk-rede mk-rede--{{ .Lado }}">
        {{- /* celular: flutua na lateral; as métricas fluem ao redor (float + shape-outside) */}}
        <img class="mk-rede__phone" src="{{ asset .Foto }}"
             alt="{{ if $en }}{{ .Rede }} profile metrics — Isabel Pontes{{ else }}Prints das métricas de {{ .Rede }} da Isabel Pontes{{ end }}"
             width="398" height="799" loading="lazy" decoding="async" />
        <div class="mk-rede__conteudo">
          <h3>{{ .Rede }}</h3>

          <div class="mk-kpis">
            <div class="mk-kpi"><strong>{{ .Seguidores }}</strong><span>{{ t $.Lang "mk.seguidores" }}</span></div>
            <div class="mk-kpi"><strong>{{ .Views }}</strong><span>{{ t $.Lang "mk.visualizacoes" }}</span></div>
          </div>

          <h4>{{ t $.Lang "mk.publico" }}</h4>
          <div class="mk-barras">
            {{- range .Locais }}
            <div class="mk-barra">
              <div class="mk-barra__topo"><span>{{ .Rotulo.T $.Lang }}</span><strong>{{ .Pct }}%</strong></div>
              <div class="mk-barra__trilha"><span class="mk-barra__preenche" style="width:{{ .Pct }}%"></span></div>
            </div>
            {{- end }}
          </div>

          <div class="mk-donuts">
            <div class="mk-donut-linha">
              <span class="mk-donut" style="background:{{ donut .Genero }}"></span>
              <ul class="mk-legenda">
                {{- range .Genero }}
                <li><span class="mk-ponto" style="background:{{ .Cor }}"></span><strong>{{ .Pct }}%</strong> {{ .Rotulo.T $.Lang }}</li>
                {{- end }}
              </ul>
            </div>
            <div class="mk-donut-linha">
              <span class="mk-donut" style="background:{{ donut .Idades }}"></span>
              <ul class="mk-legenda">
                {{- range .Idades }}
                <li><span class="mk-ponto" style="background:{{ .Cor }}"></span><strong>{{ .Pct }}%</strong> {{ .Rotulo.T $.Lang }}</li>
                {{- end }}
              </ul>
            </div>
          </div>
        </div>
      </article>
      {{- end }}
    </div>
  </section>

  {{- /* Processo — <details> nativo (sem JS) */}}
  <section id="processo" class="mk-secao mk-processo">
    <h2>{{ t .Lang "mk.comoFunciona" }}</h2>
    <p class="mk-processo__pill">{{ .TempoMedio.T .Lang }}</p>

    <ol class="mk-passos">
      {{- range .Processo }}
      <li class="mk-passo">
        <span class="mk-passo__num" aria-hidden="true">{{ .Num }}</span>
        <div class="mk-passo__corpo">
          <h3>{{ .Titulo.T $.Lang }}</h3>
          <p>{{ .Resumo.T $.Lang }}</p>
          <details class="mk-passo__mais">
            <summary>{{ t $.Lang "mk.entenda" }} <span class="mk-passo__prazo">{{ .Prazo.T $.Lang }}</span></summary>
            <ul>
              {{- range .Detalhes }}
              <li>{{ .T $.Lang }}</li>
              {{- end }}
            </ul>
          </details>
        </div>
      </li>
      {{- end }}
    </ol>
  </section>

  {{- /* Investimento */}}
  {{- range .Investimentos }}
  {{- $tag := .Tag }}
  <section
    {{- if eq .Tag "UGC" }} id="investimento"{{ end }} class="mk-secao mk-invest">
    <h2>{{ .Titulo.T $.Lang }}</h2>
    {{- $sub := .Subtitulo.T $.Lang }}{{ with $sub }}<p class="mk-invest__sub">{{ . }}</p>{{ end }}

    <div class="mk-pacotes">
      {{- range .Pacotes }}
      <article class="mk-pacote{{ if .Destaque }} mk-pacote--destaque{{ end }}">
        {{- if .Destaque }}<span class="mk-pacote__selo">{{ t $.Lang "mk.maisPopular" }}</span>{{ end }}
        <h3>{{ .Nome.T $.Lang }}</h3>
        <p class="mk-pacote__resumo">{{ .Resumo.T $.Lang }}</p>
        <ul class="mk-pacote__itens">
          {{- range .Itens }}
          <li>{{ .T $.Lang }}</li>
          {{- end }}
        </ul>
        <p class="mk-pacote__preco">{{ .Preco }}</p>
        {{- $msg := printf (t $.Lang "mk.wppPacote") (.Nome.T $.Lang) $tag (.Resumo.T $.Lang) }}
        <a class="mk-btn mk-pacote__cta" href="{{ wpp $msg }}" target="_blank" rel="noopener">{{ t $.Lang "mk.solicitar" }}</a>
      </article>
      {{- end }}
    </div>
  </section>
  {{- end }}

  {{- /* Rodapé próprio do mídia kit: contato + redes (o layout esconde o padrão). */}}
  <footer class="mk-contato">
    <h2>{{ t .Lang "mk.contatoTitulo" }}</h2>
    <p>{{ t .Lang "mk.contatoSub" }}</p>
    <div class="mk-contato__redes">
      <a href="{{ wpp (t .Lang "mk.wppGeral") }}" target="_blank" rel="noopener" aria-label="WhatsApp">{{ svg "img/social/whatsapp.svg" }}</a>
      <a href="mailto:isabelpontesfotografia@gmail.com" aria-label="E-mail">{{ svg "img/social/email.svg" }}</a>
      <a href="https://instagram.com/isapontesfoto" target="_blank" rel="noopener" aria-label="Instagram">{{ svg "img/social/instagram.svg" }}</a>
      <a href="https://www.tiktok.com/@isabelpontesfoto" target="_blank" rel="noopener" aria-label="TikTok">{{ svg "img/social/tiktok.svg" }}</a>
    </div>
    {{- /* no papel o ícone não diz nada: os contatos viram texto (só no print) */}}
    <p class="mk-contato__print">
      isabelpontesfotografia@gmail.com · instagram.com/isapontesfoto · wa.me/554191977011
    </p>
    <p class="mk-contato__copy">© {{ .Ano }} Isa Pontes</p>
  </footer>

</div>
{{ end }}
