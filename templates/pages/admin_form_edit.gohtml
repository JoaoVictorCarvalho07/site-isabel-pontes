{{- /* Editor de um formulario (Fase B, docs §8b). Cada bloco e um <form>
       proprio com POST + redirect: sem JS obrigatorio, cada acao e atomica, e
       mexer num bloco nao perde a edicao de outro. */ -}}
{{ define "conteudo" }}
<section class="admin admin-editor">
  <header class="admin__head">
    <div>
      <h1>{{ .Titulo }}</h1>
      <p>Edite em português. A versão em inglês de um texto alterado é revista depois.</p>
    </div>
    <nav class="admin__filtros">
      <a href="/admin/forms">← Formulários</a>
      <a href="{{ .PreviewURL }}" target="_blank" rel="noopener">Ver ao vivo ↗</a>
    </nav>
  </header>

  {{- if .Salvo }}
  <p class="admin__flash" role="status">Salvo ✓</p>
  {{- end }}

  {{- /* Textos do formulário */}}
  <form class="editor-bloco" method="post" action="/admin/forms/{{ .Slug }}">
    <h2 class="editor-bloco__titulo">Textos do formulário</h2>
    <label>Título
      <input name="titulo" value="{{ .Textos.TituloPT }}" required maxlength="200">
    </label>
    <label>Subtítulo
      <input name="subtitulo" value="{{ .Textos.SubtituloPT }}" maxlength="400">
    </label>
    <label>Texto do botão de envio
      <input name="enviar" value="{{ .Textos.EnviarPT }}" required maxlength="80">
    </label>
    <label>Mensagem depois de enviar
      <textarea name="sucesso" rows="2" maxlength="400">{{ .Textos.SucessoPT }}</textarea>
    </label>
    <button type="submit" class="editor-salvar">Salvar textos</button>
  </form>

  {{- /* Perguntas */}}
  <h2 class="editor-secao">Perguntas</h2>
  {{- range .Perguntas }}
  <article class="q-card{{ if .Oculta }} q-card--oculta{{ end }}">
    <div class="q-card__head">
      <span class="q-card__tipo">{{ .TipoRotulo }}</span>
      {{- if .Obrigatoria }}<span class="q-card__obr">obrigatória</span>{{ end }}
      {{- if .Oculta }}<span class="q-card__off">escondida</span>{{ end }}
      {{- if gt .Respostas 0 }}<span class="q-card__resp">{{ .Respostas }} resposta{{ if ne .Respostas 1 }}s{{ end }}</span>{{ end }}
      {{- if .ENStale }}<span class="q-card__stale" title="O texto em português mudou; falta atualizar o inglês.">EN a revisar</span>{{ end }}
      <div class="q-card__mover">
        <form method="post" action="/admin/forms/{{ $.Slug }}/perguntas/{{ .ID }}/mover">
          <input type="hidden" name="dir" value="cima">
          <button type="submit" aria-label="Subir" {{ if .Primeira }}disabled{{ end }}>↑</button>
        </form>
        <form method="post" action="/admin/forms/{{ $.Slug }}/perguntas/{{ .ID }}/mover">
          <input type="hidden" name="dir" value="baixo">
          <button type="submit" aria-label="Descer" {{ if .Ultima }}disabled{{ end }}>↓</button>
        </form>
      </div>
    </div>

    <form method="post" action="/admin/forms/{{ $.Slug }}/perguntas/{{ .ID }}" class="q-card__edit">
      <label>Pergunta
        <input name="label" value="{{ .LabelPT }}" required maxlength="300">
      </label>
      <label>Texto de ajuda <span class="q-card__op">(opcional)</span>
        <input name="ajuda" value="{{ .AjudaPT }}" maxlength="500">
      </label>
      {{- if .EhSelect }}
      <label>Opções <span class="q-card__op">(uma por linha)</span>
        <textarea name="opcoes" rows="4">{{ .OpcoesTexto }}</textarea>
      </label>
      {{- end }}
      <label class="q-card__check">
        <input type="checkbox" name="obrigatoria" {{ if .Obrigatoria }}checked{{ end }}> Resposta obrigatória
      </label>
      <button type="submit" class="editor-salvar">Salvar pergunta</button>
    </form>

    {{- /* Ações destrutivas (Fase C): trocar tipo, esconder, apagar. Ficam num
           <details> para não competir com a edição normal. */}}
    <details class="q-card__avancado">
      <summary>Mais ações</summary>

      {{- $tipoAtual := .Tipo }}
      <form method="post" action="/admin/forms/{{ $.Slug }}/perguntas/{{ .ID }}/tipo" class="q-card__tipo-form">
        <label>Trocar o tipo de resposta
          <select name="tipo" data-tipo-troca>
            {{- range .Tipos }}
            <option value="{{ .Valor }}" {{ if eq .Valor $tipoAtual }}selected{{ end }}>{{ .Rotulo }}</option>
            {{- end }}
          </select>
        </label>
        {{- /* Sem `hidden` por padrão: sem JS fica sempre visível; o servidor
               só usa quando o tipo alvo é lista. */}}
        <label data-opcoes-troca>Opções da lista <span class="q-card__op">(uma por linha, só se o tipo for "Lista")</span>
          <textarea name="opcoes" rows="3">{{ .OpcoesTexto }}</textarea>
        </label>
        <button type="submit">Trocar tipo</button>
        {{- if gt .Respostas 0 }}
        <p class="q-card__aviso-mini">Esta pergunta já tem {{ .Respostas }} resposta{{ if ne .Respostas 1 }}s{{ end }}. As respostas antigas continuam guardadas com o texto que era.</p>
        {{- end }}
      </form>

      <div class="q-card__perigo">
        {{- /* Esconder: sempre disponível, reversível */}}
        <form method="post" action="/admin/forms/{{ $.Slug }}/perguntas/{{ .ID }}/ocultar">
          <input type="hidden" name="oculta" value="{{ if .Oculta }}0{{ else }}1{{ end }}">
          <button type="submit">{{ if .Oculta }}Mostrar de novo{{ else }}Esconder do formulário{{ end }}</button>
        </form>

        {{- /* Apagar: só quando não há respostas. Com respostas, esconder é o caminho. */}}
        {{- if .PodeApagar }}
        <form method="post" action="/admin/forms/{{ $.Slug }}/perguntas/{{ .ID }}/apagar"
              onsubmit="return confirm('Apagar esta pergunta de vez? Não dá para desfazer.');">
          <button type="submit" class="q-card__apagar">Apagar de vez</button>
        </form>
        {{- else }}
        <p class="q-card__aviso-mini">Não dá para apagar: já tem resposta. Use “Esconder” — as respostas ficam guardadas.</p>
        {{- end }}
      </div>
    </details>
  </article>
  {{- end }}

  {{- /* Nova pergunta */}}
  <form class="editor-bloco editor-nova" method="post" action="/admin/forms/{{ .Slug }}/perguntas">
    <h2 class="editor-bloco__titulo">Adicionar pergunta</h2>
    <label>Pergunta
      <input name="label" required maxlength="300" placeholder="Ex.: Como você prefere ser chamada?">
    </label>
    <label>Texto de ajuda <span class="q-card__op">(opcional)</span>
      <input name="ajuda" maxlength="500">
    </label>
    <label>Tipo de resposta
      <select name="tipo" data-tipo-nova>
        {{- range .Tipos }}
        <option value="{{ .Valor }}">{{ .Rotulo }}</option>
        {{- end }}
      </select>
    </label>
    {{- /* Sem `hidden` por padrão: sem JS o campo fica sempre visível (o
           servidor ignora opções fora do tipo lista). O JS abaixo o esconde
           quando o tipo não é lista, só por elegância. */}}
    <label data-opcoes-nova>Opções <span class="q-card__op">(uma por linha, só para "Lista de opções")</span>
      <textarea name="opcoes" rows="4" placeholder="Uma opção por linha"></textarea>
    </label>
    <label class="q-card__check">
      <input type="checkbox" name="obrigatoria"> Resposta obrigatória
    </label>
    <button type="submit" class="editor-salvar">Adicionar</button>
  </form>
</section>

{{- /* Um toque de JS opcional: mostra o campo de opções só quando o tipo é
       "lista". Sem ele o campo fica sempre visível (degrada bem). */}}
<script>
  // Mostra o campo de opções só quando o tipo escolhido é "lista". Enfeite:
  // sem JS o campo fica visível e o servidor ignora fora do tipo lista.
  (function () {
    function ligar(sel, opc) {
      if (!sel || !opc) return;
      function sync() { opc.hidden = sel.value !== 'select'; }
      sel.addEventListener('change', sync);
      sync();
    }
    // "Adicionar pergunta"
    ligar(document.querySelector('[data-tipo-nova]'), document.querySelector('[data-opcoes-nova]'));
    // "Trocar tipo" de cada pergunta
    document.querySelectorAll('[data-tipo-troca]').forEach(function (sel) {
      ligar(sel, sel.closest('form').querySelector('[data-opcoes-troca]'));
    });
  })();
</script>
{{ end }}
