{{- /*
  Navbar. O logo e o SVG inline (funcao `svg`) para herdar currentColor -- a cor
  vem do texto do header, que muda por pagina via a classe no <body> (BodyClass).
  Substitui, no lado Go, todo o NavBar.tsx do React: sem estado de logoSrc, sem
  matchMedia, sem os dois useEffect, e sem o flash de logo errada.

  Hide-on-scroll e menu mobile entram na Fase 2 (aqui e so o logo + links).
*/ -}}
{{ define "navbar" }}
<header class="navbar">
  <a href="/" class="navbar__logo logo-anim-focus" aria-label="Isabel Pontes">
    {{ svg "img/logo.svg" }}
  </a>
  <nav class="navbar__links" aria-label="Principal">
    <a href="/galeria">Galeria</a>
    <a href="/sobre">Sobre</a>
    <a href="/contato">Contato</a>
  </nav>
</header>
{{ end }}
