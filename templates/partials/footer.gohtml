{{- /*
  Rodape. No React isto era markup solto dentro de App.tsx, com a classe
  `gallery-footer` -- resquicio da galeria antiga, e o unico elemento da home
  que de fato usava Cormorant Garamond.
*/ -}}
{{ define "footer" }}
<footer class="rodape">
  <p>© {{ .Ano }} Isabel Pontes · Todos os direitos reservados</p>
</footer>
{{ end }}
