# Copie para .env e preencha. O .env nunca e versionado.
#
# ATENCAO: as chaves R2 do projeto React vazaram para o historico do git
# (commits ba63f71, 663f32a, 53d0f94 -- o f3d40a8 so removeu do tracking, o
# conteudo continua recuperavel). Rotacione no painel da Cloudflare antes de
# reusar qualquer valor aqui.

# Base publica de leitura das fotos.
# Hoje e o dominio r2.dev do bucket. Precisa virar dominio proprio para o
# Cloudflare Image Transformations funcionar (nao opera no *.r2.dev).
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxx.r2.dev

# Credenciais S3d do R2 -- usaas SOMENTE pelo `site sync`, nunca ao servir request.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Bucket NOVO (migracao de midia: scripts/migrate_media.py) ---
# A ideia: criar um bucket limpo, gerar as variantes nele, conferir, e so entao
# deletar o bucket antigo. A chave comprometida morre junto com o bucket antigo.
# Estas credenciais precisam de permissao de ESCRITA no bucket novo.
# O script le os originais pela URL publica do bucket antigo -- nao usa a chave
# velha para nada.
R2_NEW_ACCOUNT_ID=
R2_NEW_ACCESS_KEY_ID=
R2_NEW_SECRET_ACCESS_KEY=
R2_NEW_BUCKET=
# Base publica do bucket novo -- entra nas URLs do manifest gerado.
R2_NEW_PUBLIC_BASE=https://pub-yyyyyyyyyyyy.r2.dev

# Runtime
ADDR=:8080
DB_PATH=data/site.db
# URL canonica: entra no og:url, no canonical e no sitemap.
# Sem isso o preview de link no WhatsApp/Instagram nao resolve a imagem.
BASE_URL=https://isabelpontes.com.br
