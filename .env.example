# Copie para .env e preencha. O .env nunca e versionado.
#
# ATENCAO: as chaves R2 do projeto React vazaram para o historico do git
# (commits ba63f71, 663f32a, 53d0f94 -- o f3d40a8 so removeu do tracking, o
# conteudo continua recuperavel). Rotacione no painel da Cloudflare antes de
# reusar qualquer valor aqui.

# Base publica de leitura das fotos.
# Hoje e o dominio r2.dev do bucket. Precisa virar dominio proprio para o
# Cloudflare Image Transformations funcionar (nao opera no *.r2.dev).
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxx.r2.dev

# Credenciais S3d do R2 -- usaas SOMENTE pelo `site sync`, nunca ao servir request.
R2_ACCOUNT_ID=53c65b3b59a7777c76d408350f73bd60
R2_ACCESS_KEY_ID=a6774298966c2b547fc690fb8b5f444d
R2_SECRET_ACCESS_KEY=84aabbda62b410c32fd14573abc53d9d28109103a0acaf4a126a5942238c95aa
R2_BUCKET=isabel-portfolio-gallery

# --- Bucket NOVO (migracao de midia: scripts/migrate_media.py) ---
# A ideia: criar um bucket limpo, gerar as variantes nele, conferir, e so entao
# deletar o bucket antigo. A chave comprometida morre junto com o bucket antigo.
# Estas credenciais precisam de permissao de ESCRITA no bucket novo.
# O script le os originais pela URL publica do bucket antigo -- nao usa a chave
# velha para nada.
R2_NEW_ACCOUNT_ID=
R2_NEW_ACCESS_KEY_ID=
R2_NEW_SECRET_ACCESS_KEY=
R2_NEW_BUCKET=
# Base publica do bucket novo -- entra nas URLs do manifest gerado.
R2_NEW_PUBLIC_BASE=https://pub-yyyyyyyyyyyy.r2.dev

# --- Briefings (formularios) -------------------------------------------------
# TUDO OPCIONAL. Sem nada disso o site funciona igual: as respostas sao gravadas
# no SQLite normalmente. O que muda e como a Isa fica sabendo delas.

# Resend: envia um e-mail a cada briefing recebido. Sem a chave, so fica o log.
# O MAIL_DE precisa ser de um dominio VERIFICADO no painel do Resend (registros
# DNS na Cloudflare), senao a API recusa o envio.
RESEND_API_KEY=
MAIL_DE=briefing@isabelpontes.com.br
MAIL_PARA=

# Painel /admin: le os briefings direto do banco, sem depender do e-mail.
# Sem estas duas, a rota /admin responde 404 (nao fica aberta).
# ATENCAO: basic-auth manda a senha a cada request, so protegida pelo TLS --
# enquanto o site estiver em http:// puro, use uma senha descartavel.
ADMIN_USER=
ADMIN_SENHA=

# Runtime
ADDR=:8080
DB_PATH=data/site.db
# URL canonica: entra no og:url, no canonical e no sitemap.
# Sem isso o preview de link no WhatsApp/Instagram nao resolve a imagem.
BASE_URL=https://isabelpontes.com.br

# --- Next (branch reescrita-next) --------------------------------------------
# Login do /admin: cliente OAuth do Google e segredo que assina o cookie de sessao.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=https://isabelpontes.com.br
# E-mails que podem entrar no /admin, separados por virgula.
ADMIN_EMAILS=
# Bucket privado para os originais das fotos. Sem isto eles vao para o R2_BUCKET.
R2_BUCKET_ORIGINAIS=
UPLOAD_DIR=data/uploads
